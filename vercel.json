{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "runtime": "vercel-node@3.0.0"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|@|node_modules/|src/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
