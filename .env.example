# Nil Finance - Variables de entorno
# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repositorio.

# Base de datos (Vercel Postgres / Neon)
# En Vercel: se inyecta automáticamente como POSTGRES_URL o DATABASE_URL
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Clerk - Autenticación
# Crea una aplicación en https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
